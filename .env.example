# Copy this file to .env.local and fill in your key, then restart `npm run dev`.
# The key is read only by the server-side routes in src/app/api/ai/ and never sent to the browser.
# Leave it empty to run without AI: every feature falls back to the rule-based engine.
#
# Free key: https://aistudio.google.com → "Get API key". No credit card needed.
# On the free tier Google may use requests to improve its products, so only upload test or public data.
GEMINI_API_KEY=

# Optional: pin a specific model (default: gemini-flash-latest, Google's alias for the current Flash model).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Upstash Redis for a shared AI answer cache and rate limit (recommended on Vercel).
# On Vercel, connecting Upstash from the Storage tab adds KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# Locally, copy the REST URL and token from console.upstash.com. Leave empty to use server memory instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
